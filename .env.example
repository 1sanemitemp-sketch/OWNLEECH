# ---- Required ----
API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC...
OWNER_ID=123456789

# ---- Optional ----
# Comma separated user IDs / group IDs allowed to use the bot (owner is always allowed).
# You can also authorize from inside Telegram with /a (saved automatically).
AUTHORIZED_CHATS=
# How many tasks run at the same time
MAX_CONCURRENT=3

# Max tasks per user per day (0 = unlimited, the owner is never limited)
DAILY_TASK_LIMIT=0
# HD thumbnail: longest side in pixels (set 320 only if uploads fail with THUMB_INVALID)
THUMB_MAX=1280

# ---- Upload speed tuning (defaults are good for most servers) ----
# Parallel multi-session uploader. Set FAST_UPLOAD=0 to use the library uploader instead.
FAST_UPLOAD=1
# Parallel MTProto connections per uploaded file (1-16) and in-flight requests per connection (1-8)
UPLOAD_SESSIONS=8
UPLOAD_WORKERS=4

# ---- Status message ----
# Seconds between live status edits (minimum 3)
STATUS_INTERVAL=6
TASKS_PER_PAGE=5
